{
  "name": "github-resolver",
  "version": "1.0.0",
  "homepage": "https://github.com/maxpatiiuk/github-resolver/",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "husky && node --run build",
    "build": "node --run typeCheck && vite build",
    "lintStaged": "lint-staged && node --run test",
    "test": "node --run build && node --run unitTests",
    "typeCheck": "node node_modules/typescript-7/bin/tsc",
    "unitTests": "vitest run",
    "unitTests:watch": "vitest",
    "watch": "vite build --mode development --watch"
  },
  "dependencies": {
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@arcgis/eslint-config": "5.2.0-next.56",
    "@types/node": "^24.13.3",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "author": "Max Patiiuk",
  "directories": {
    "test": "__tests__"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maxpatiiuk/github-resolver.git"
  }
}
